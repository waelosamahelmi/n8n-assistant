{
  "manifest_version": 3,
  "name": "Helmies n8n Assistant",
  "version": "1.0.0",
  "description": "AI-powered assistant for n8n workflow automation with OpenRouter integration - by Helmies.fi",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
